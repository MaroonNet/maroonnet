# Root .gitignore
# Each area (backend/*, frontend/*, ml) adds its own .gitignore when its stack is chosen.

# Mission database files, wherever they are created. Never commit one: they hold real
# positions and names of real people.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
missions/

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Per-person Claude files (the shared settings live in .claude/settings.json)
CLAUDE.local.md
.claude/settings.local.json

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
